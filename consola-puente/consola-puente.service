# Servicio systemd DE USUARIO (corre como urben, no como root).
# Instalar:  consola-puente/instalar.sh
[Unit]
Description=Consola del servidor para LinkManager (terminales persistentes por socket UNIX)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/.local/lib/consola-puente/puente.py
Restart=on-failure
RestartSec=3
# Los terminales son hijos de este servicio: al pararlo se cierran.
KillMode=mixed
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=default.target
